# Milo AI / Second Brain AI System — Environment Configuration Template
# Place private keys in .env (never commit real secrets to version control)

# Server Port
PORT=3000

# Server-side AI Provider Secrets (Required for live Gemini AI queries)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Cryptographic Session & JWT Signing Secret (Must be >= 32 characters of high-entropy material)
# Required in production; missing, short (<32ch), or legacy secrets fail closed
MILO_SESSION_SECRET=replace_with_a_secure_random_at_least_32_characters_long_secret
JWT_SECRET=replace_with_a_secure_random_at_least_32_characters_long_secret

# Optional Replicate API Token (For video generation models)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Optional Database & Distributed Persistence URL (Postgres or Upstash/Redis for multi-instance serverless)
DATABASE_URL=postgres://user:password@localhost:5432/milo_db
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
# KV_REST_API_URL=https://your-kv-store.upstash.io
# KV_REST_API_TOKEN=your_kv_token_here


# Juno AI / Second Brain AI System — Environment Configuration Template
# Place private keys in .env (never commit secrets to version control)

# Server Port
PORT=3000

# Server-side AI Provider Secrets
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_juno_ai_2026

# Optional PostgreSQL Persistence URL
DATABASE_URL=postgres://user:password@localhost:5432/juno_db

# Optional durable reminder persistence (HTTPS Upstash Redis REST endpoint + token).
# Saved reminders remain disabled until both values are configured server-side.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cryptographic session signing secret for reminders (and general Milo sessions).
# Must be at least 32 characters and at least 32 bytes (256-bit entropy).
# Generate using: openssl rand -hex 32  (or: openssl rand -base64 32)
MILO_SESSION_SECRET=


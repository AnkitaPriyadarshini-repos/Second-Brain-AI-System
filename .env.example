# ==============================================================================
# Milo AI / Second Brain AI System — Production Environment Variables Template
# ==============================================================================
# Set these in your Vercel Project Settings > Environment Variables.
# NEVER commit unredacted secrets (.env) to version control.

# ------------------------------------------------------------------------------
# 1. P0 SECURITY & CRYPTOGRAPHY (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# High-entropy cryptographic secrets (minimum 32 characters).
# Server fails closed at startup if missing or less than 32 characters in production.
MILO_SESSION_SECRET=replace_with_a_cryptographically_secure_random_64_char_secret
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_char_secret

# Server Port (Defaults to 3000 in standalone node environment)
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE AI PROVIDER CREDENTIALS (MANDATORY FOR LIVE AI)
# ------------------------------------------------------------------------------
# All AI calls route exclusively through authenticated server-side BFF API.
# Google Gemini API Key (Gemini 1.5 Flash / Pro):
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional: Fallback OpenAI API Key (GPT-4o / GPT-4o-mini):
# OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED RATE LIMITING & TOKEN BUDGETS (UPSTASH / VERCEL KV)
# ------------------------------------------------------------------------------
# Connects atomic sliding-window rate limiting (30 req/min, 5 img/hr)
# and daily token budget caps (100k auth / 20k guest) across serverless containers.
# Option A: Upstash Redis REST
UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Option B: Vercel KV (Auto-populated if using Vercel KV integration)
# KV_REST_API_URL=https://your-vercel-kv.upstash.io
# KV_REST_API_TOKEN=your_vercel_kv_rest_token_here

# ------------------------------------------------------------------------------
# 4. DATABASE & SERVERLESS CONNECTION POOLING (POSTGRESQL)
# ------------------------------------------------------------------------------
# Multi-tenant PostgreSQL instance (Supabase, Neon, AWS RDS, Railway).
# For serverless, use connection pooler URL (e.g. Supabase port 6543 / Neon pooler):
DATABASE_URL=postgres://user:password@pooler.example.com:6543/postgres?pgbouncer=true

# Serverless pool sizing: Defaults to 2 per serverless container to prevent
# exhausting PostgreSQL max_connections at 100+ concurrent Lambda invocations.
PG_POOL_MAX=2
PG_IDLE_TIMEOUT=10000
POSTGRES_SSL=true

# ------------------------------------------------------------------------------
# 5. OAUTH AUTHENTICATION PROVIDERS (OPTIONAL)
# ------------------------------------------------------------------------------
# Client IDs for Google and GitHub OAuth 2.0 tenant authentication:
# GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# GITHUB_CLIENT_ID=your_github_oauth_client_id

# ------------------------------------------------------------------------------
# 6. ASYNC MEDIA GENERATION (OPTIONAL)
# ------------------------------------------------------------------------------
# Credentials for video generation models (Milo Create Studio):
# REPLICATE_API_TOKEN=your_replicate_api_token_here
# FAL_KEY=your_fal_api_key_here
# LUMA_API_KEY=your_luma_api_key_here

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & TELEMETRY
# ------------------------------------------------------------------------------
# DEBUG=false
